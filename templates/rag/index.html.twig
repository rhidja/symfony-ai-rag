{% extends 'base.html.twig' %}

{% block title %}RAG - Chat{% endblock %}

{% block body %}
    <div class="container py-4 d-flex flex-column" style="max-width: 720px; height: 100vh;" data-controller="rag-chat">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Base de connaissances</h1>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-rag-chat-target="clear" data-action="rag-chat#clear">
                Nouvelle conversation
            </button>
        </div>

        <div class="alert alert-danger d-none" data-rag-chat-target="error"></div>

        <div class="flex-grow-1 overflow-auto border rounded-3 bg-white p-3 mb-3" data-rag-chat-target="messages"></div>

        <p class="text-muted text-center d-none" data-rag-chat-target="empty">
            Posez une question sur les documents indexés pour démarrer la conversation.
        </p>

        <form class="d-flex gap-2" data-action="rag-chat#submit">
            <textarea class="form-control" rows="2" placeholder="Votre question" data-rag-chat-target="question" required></textarea>
            <button type="submit" class="btn btn-primary align-self-end" data-rag-chat-target="submit">Envoyer</button>
        </form>
    </div>
{% endblock %}
